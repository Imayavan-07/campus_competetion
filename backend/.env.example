# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=unisync_campus

# JWT Security & Encryption
JWT_SECRET=unisync_super_secret_jwt_encryption_key_2026!
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Local File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Default Admin Account Credentials
ADMIN_NAME="Chief Administrator"
ADMIN_EMAIL="admin@university.edu"
ADMIN_PASSWORD="Admin@123456"

# Default Student Account Credentials
STUDENT_NAME="Alex Vance"
STUDENT_EMAIL="student@university.edu"
STUDENT_PASSWORD="Student@123456"

# Default Club Organizer Credentials
CLUB_LEAD_NAME="Bob Smith"
